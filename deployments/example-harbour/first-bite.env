# Environment of the first-bite service at example-harbour:
# /etc/first-bite/first-bite.env, mode 0640 root:firstbite. A template: every
# value is an example, and the one marked REPLACE is set on the host.
# systemd reads this file (EnvironmentFile=); restart the service after
# editing: sudo systemctl restart first-bite

# Network interface to capture on: the port the harbour's switch mirrors the
# buoys' link to.
FIRST_BITE_INTERFACE=eth1

# Extra arguments for mind, separated by spaces. None here.
FIRST_BITE_ARGS=

# The harbour-buoy dictionary, checked out from the overlay at a reviewed
# commit.
BITE_DICT_PATH=/etc/first-bite/dictionaries/harbour-buoy/dictionary

# The sinks: subscribers.yml of this directory.
SUBSCRIBER_CONFIG_PATH=/etc/first-bite/config/subscribers.yml

# Credentials of the sinks. subscribers.yml names this variable; the secret
# key is a file (first-bite.service.d/example-harbour.conf). Write the value
# without quotes.
HARBOUR_ARCHIVE_ACCESS_KEY_ID=REPLACE-WITH-THE-ARCHIVE-ACCESS-KEY-ID

# Copied into every record and every log line.
DATA_SOURCE_NETWORK_NAME=harbour-buoy-link
DATA_SOURCE_GEO_LOCATION=example-harbour
DATA_SOURCE_SYSTEM_TYPE=harbour-buoy
DATA_SOURCE_OWNER=example-harbour-office
# Handling label of the captured data, as your organisation writes it.
DATA_PACKET_CLASSIFICATION=example-label

RUST_LOG=info
NO_COLOR=1
